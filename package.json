{
  "name": "zara-twin",
  "private": true,
  "description": "AI Ð´Ð²Ð¾Ð¹Ð½Ð¸Ðº Ð½Ð° Ñ€ÑŠÐºÐ¾Ð²Ð¾Ð´Ð¸Ñ‚ÐµÐ»Ñ: Live Copilot Ð¸ Ð°Ð²Ñ‚Ð¾Ð½Ð¾Ð¼ÐµÐ½ Ð´Ð²Ð¾Ð¹Ð½Ð¸Ðº",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/stt-whisper",
    "packages/knowledge",
    "packages/hints",
    "apps/extension",
    "apps/dashboard",
    "tools/stt-bench",
