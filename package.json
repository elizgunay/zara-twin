{
  "name": "zara-twin",
  "private": true,
  "description": "AI двойник на ръководителя: Live Copilot и автономен двойник",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/extension",
    "tools/strategy-doc"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/extension --noEmit",
    "build:extension": "npm run build -w @zara-twin/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "strategy-doc": "node tools/strategy-doc/build.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
