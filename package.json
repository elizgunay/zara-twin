  "scripts": {
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/stt-whisper --noEmit && tsc -p packages/knowledge --noEmit && tsc -p packages/hints --noEmit && tsc -p apps/extension --noEmit && tsc -p tools/stt-bench --noEmit && tsc -p apps/dashboard --noEmit",
    "build:extension": "npm run build -w @zara-twin/extension",
    "dashboard": "npm run dev -w @zara-twin/dashboard",
    "bench:stt": "tsx tools/stt-bench/src/bench.ts",
    "bench:sample": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stt-bench/make-tts-sample.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "strategy-doc": "node tools/strategy-doc/build.js",
    "client-brief": "node tools/strategy-doc/client-brief.js",
    "pilot-guide": "node tools/strategy-doc/pilot-guide.js",
    "pilot-package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pilot-package.ps1",
    "bench:speechmatics": "tsx tools/stt-bench/src/speechmatics.ts",
    "pilot-package:with-key": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pilot-package.ps1 -WithKey",
    "bench:recordings": "tsx tools/stt-bench/src/transcribe-recordings.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.15.0",
