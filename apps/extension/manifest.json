{
  "manifest_version": 3,
  "name": "Zara Copilot",
  "description": "Подсказки на живо в Google Meet (пилот, Фаза 1.0)",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Zara Copilot: включи/изключи (прихваща звука на срещата)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://www.googleapis.com/*",
    "https://mp.speechmatics.com/*"
  ],
  "key": ""
}
