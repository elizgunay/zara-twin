# Копирайте този файл като .env и попълнете стойностите. .env НИКОГА не влиза в git.
# Инструкции: docs/setup/cloud-stt-accounts.md

# Google Calendar (само свободни/заети часове). Инструкции: docs/setup/google-calendar.md
# Client ID не е тайна, но е различен за всяка инсталация. След промяна: npm run build:extension
GOOGLE_OAUTH_CLIENT_ID=

# --- Отложено: облачно разпознаване на говор (docs/setup/cloud-stt-accounts.md) ---
# Microsoft Azure Speech (регион само в ЕС: westeurope, swedencentral, …)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Google Cloud Speech-to-Text
# Пътят до JSON ключа на сервизния акаунт. Файлът стои ИЗВЪН папката на проекта.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\<вие>\.zara-twin\google-stt.json
GOOGLE_CLOUD_PROJECT=
# „eu“ = обработка само в ЕС
GOOGLE_STT_LOCATION=eu

# Speechmatics (за сравнение, без карта). Регион само в ЕС.
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu1

# Табло (Supabase, регион Frankfurt). Инструкции: docs/setup/supabase.md
# Само Publishable key (sb_publishable_…). Secret key НИКОГА тук, в разширението или таблото.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Адресът на таблото онлайн (бутонът „Отвори в таблото“ след срещата). Празно = стойността по подразбиране.
DASHBOARD_URL=https://zara-copilot.pages.dev
